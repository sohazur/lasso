# Lasso — environment variables
# Copy this to .env and fill in your sponsor API keys.
# Each block below tells you where to sign up.

# -----------------------------------------------------------------------------
# AgentPhone (P26) — outbound voice calls
# Sign up: https://agentphone.com (or whatever the sponsor link is at the event)
# What you need: API key + a provisioned phone number to call FROM
# -----------------------------------------------------------------------------
AGENTPHONE_API_KEY=
LASSO_PHONE_NUMBER=+14150000000

# Optional: skip the listAgents() round-trip on boot by hard-coding the
# pre-provisioned shared agent + number IDs. Useful when AgentPhone's API
# is slow or temporarily down. Look these up once from the dashboard.
LASSO_SHARED_AGENT_ID=
LASSO_SHARED_NUMBER_ID=

# -----------------------------------------------------------------------------
# Supermemory — cross-call memory by {merchant_id}:{phone}
# Sign up: https://supermemory.ai
# What you need: workspace ID + API key. Default region: US.
# -----------------------------------------------------------------------------
SUPERMEMORY_API_KEY=
SUPERMEMORY_WORKSPACE_ID=

# -----------------------------------------------------------------------------
# Moss (F25) — real-time semantic search for store KB during calls
# Sign up: https://moss.dev
# What you need: project credentials (id + key)
# -----------------------------------------------------------------------------
MOSS_PROJECT_ID=
MOSS_PROJECT_KEY=

# -----------------------------------------------------------------------------
# Supabase — postgres + auth + realtime for the dashboard
# Sign up: https://supabase.com (free tier is fine for hackathon)
# What you need: project URL + service role key (NOT anon key, since server uses it)
# Apply migrations from server/src/db/schema.sql in the SQL editor.
# -----------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Public anon key for the dashboard frontend (used in dashboard workspace only)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# -----------------------------------------------------------------------------
# Stripe (S09) — attribution: which calls led to recovered checkouts
# Sign up: https://stripe.com (or use a test account — sk_test_* is fine)
# What you need: secret key + webhook signing secret
# Set the webhook endpoint to: {PUBLIC_URL}/webhooks/stripe
# Listen for: payment_intent.succeeded
# -----------------------------------------------------------------------------
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# AgentMail (S25) — fallback email when the call doesn't connect
# Sign up: https://agentmail.com
# What you need: API key + a sending domain or default sender
# -----------------------------------------------------------------------------
AGENTMAIL_API_KEY=
AGENTMAIL_FROM=hi@lasso.example

# -----------------------------------------------------------------------------
# Firecrawl — on-demand site scrape to build store KB at call-trigger time
# Sign up: https://firecrawl.dev
# What you need: API key (the cheap plan is fine for hackathon scope)
# -----------------------------------------------------------------------------
FIRECRAWL_API_KEY=

# -----------------------------------------------------------------------------
# OpenRouter — LLM gateway (use Gemini Flash Lite or Claude Haiku for voice)
# Sign up: https://openrouter.ai
# What you need: API key
# -----------------------------------------------------------------------------
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash-lite

# -----------------------------------------------------------------------------
# Server config
# -----------------------------------------------------------------------------
PORT=3001
PUBLIC_URL=http://localhost:3001
NODE_ENV=development
LOG_LEVEL=info

# Flip to true on stage to skip real outbound calls and just log them.
# Useful if AgentPhone is rate-limited during the demo or you want a rehearsal mode.
LASSO_FAKE_CALL_MODE=false
